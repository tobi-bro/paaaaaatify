# Paaaaaaatify Backend Production & Development Configuration
PROJECT_NAME="Paaaaaaatify"
API_V1_STR="/api/v1"
ENVIRONMENT="production" # or "development"
SECRET_KEY="generate-a-strong-random-32-byte-hex-string-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200
ALGORITHM="HS256"

# Database: SQLite for local testing or managed PostgreSQL for cloud production
DATABASE_URL="postgresql://username:password@db-host:5432/paaaaaatify"
# Local fallback:
# DATABASE_URL="sqlite:///./paaaaaatify.db"

# Production CORS Explicit Allowlist (comma-separated, no unrestricted wildcards)
ALLOWED_ORIGINS="https://your-domain.com,https://api.your-domain.com,capacitor://localhost,http://localhost"

# Google OAuth 2.0 Credentials (Web Client ID used for token signature verification)
GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000
