<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Network Security: Strict TLS / HTTPS enforced, cleartext blocked -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
