# Paaaaaaatify Frontend Environment Configuration
# Production API Base URL (leave empty to derive dynamically or set your cloud HTTPS domain)
VITE_API_URL="https://api.your-domain.com/api/v1"

# Google OAuth 2.0 Web Client ID (OpenID Connect token audience)
VITE_GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"

# Google OAuth 2.0 Android Client ID (associated with com.paaaaaaatify.app & Release SHA-1)
VITE_GOOGLE_ANDROID_CLIENT_ID="your-android-client-id.apps.googleusercontent.com"

